<?xml version="1.0"?>
<ruleset name="RAN Booster Scenarios">
	<description>RAN Booster Scenarios coding standards.</description>

	<!-- Project support contract remains local to the consumer. -->
	<config name="minimum_wp_version" value="7.0"/>
	<config name="testVersion" value="8.4-8.5"/>

	<!-- Project source selection remains local to the consumer. -->
	<file>.</file>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/build/</exclude-pattern>

	<arg value="sp"/>
	<arg name="basepath" value="./"/>
	<arg name="colors"/>
	<arg value="-colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="4"/>
	<arg value="ns"/>

	<!-- Shared RAN WordPress/WPCS/PHPCompatibility ancestry. -->
	<rule ref="RANWordPressPlugin"/>
	<rule ref="RANOwnedMethods"/>

	<!-- Project identity remains local, including the repository-owned test namespace. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ran_booster"/>
				<element value="RAN\"/>
				<element value="RAN\Tests"/>
			</property>
		</properties>
	</rule>

	<!-- Starter-specific WPCS exceptions remain local without re-importing WordPress-Extra. -->


	<!-- Preserve Starter's stronger documentation and generic PHP checks. -->
	<rule ref="WordPress-Docs"/>
	<rule ref="Generic.Classes.OpeningBraceSameLine"/>
	<rule ref="Generic.ControlStructures.InlineControlStructure"/>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter"/>
	<rule ref="Generic.Commenting.Todo"/>
	<rule ref="Generic.Commenting.Fixme"/>
	<rule ref="Squiz.ControlStructures.ControlSignature"/>
	<!-- One formatter authority: enforce intended assignment/array alignment here. -->
	<rule ref="Generic.Formatting.MultipleStatementAlignment">
		<properties>
			<property name="error" value="true"/>
		</properties>
	</rule>
	<rule ref="WordPress.Arrays.MultipleStatementAlignment">
		<type>error</type>
	</rule>
</ruleset>
